# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Secrets — never commit
.env
.streamlit/secrets.toml

# Data: keep the folders (.gitkeep) but ignore their contents
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Build artifacts. The BI export (artifacts/bi/*.csv) is the one exception and IS tracked: it is a
# few hundred rows, it is what the Power BI report reads, and committing it makes every exported
# number diff-reviewable. A negation cannot reach under an excluded directory, hence the four lines.
artifacts/*
!artifacts/bi/
artifacts/bi/*
!artifacts/bi/*.csv
*.db
*.joblib

# Test / tooling caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/

# Local Postgres volume (if bind-mounted) / OS
pgdata/
.DS_Store
Thumbs.db
